# ============================================================
# LOKALOKA LANDING PAGE — environment variables
# Copy file ini menjadi .env lalu sesuaikan nilainya.
# Semua variabel Vite WAJIB diawali prefix VITE_.
# ============================================================

# Base URL API landing page (dipakai saat production build)
VITE_API_BASE_URL=https://api.landing-page.superpari.co.id/api/v1


# Link dashboard principal (tombol "Login sebagai Principal" & "Jadi Seller")
VITE_DASHBOARD_URL=https://dashboard-v2.localoka.co.id/

# Link Google Play Store aplikasi Localoka (tombol "Login sebagai Buyer",
# "Buka di Aplikasi", "Chat Sekarang", footer)
VITE_PLAYSTORE_URL=https://play.google.com/store/apps/details?id=id.co.localoka.mobile&hl=id
